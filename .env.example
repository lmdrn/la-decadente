# Base de données (en local : docker compose up -d)
DATABASE_URL=postgres://decadente:decadente@localhost:5433/decadente


# URL publique du site (sitemap, liens absolus, JSON-LD)
APP_URL=http://localhost:3000

# Contact pour l'API de géocodage OpenStreetMap (Nominatim exige un contact)
GEOCODER_CONTACT=contact@exemple.ch

# Dossier des photos envoyées (hors du dossier public)
UPLOAD_DIR=./uploads
